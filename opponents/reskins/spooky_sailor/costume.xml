<?xml version='1.0' encoding='UTF-8'?>
<costume>
    <id>spooky_sailor</id>
    <tags>
        <tag>alternative_skin</tag>
        <tag>no_underwear</tag>
        <tag>school_uniform</tag>
    </tags>
    <layers>4</layers>
    <folder>opponents/reskins/spooky_sailor/</folder>
    <wardrobe>
        <clothing name="skirt" generic="skirt" position="lower" type="major" plural="true" />
        <clothing name="bra" generic="bra" position="upper" type="important" />
        <clothing name="shirt" generic="shirt" position="upper" type="major" />
        <clothing name="knife" generic="" position="hands" type="extra" />
    </wardrobe>

    <poses>
        <pose id="2-stripped">
            <sprite id="stripped1" src="reskins/spooky_sailor/2-stripped1.png" x="0" y="0" alpha="100" />
            <sprite id="stripped2" src="reskins/spooky_sailor/2-stripped2.png" x="0" y="0" alpha="0" />
            <directive type="animation" id="stripped1" ease="smooth" interpolation="linear">
                <keyframe time="0" x="0" y="0" alpha="100" />
                <keyframe time="1" alpha="100" />
                <keyframe time="3" alpha="0" />
            </directive>
            <directive type="animation" id="stripped2" ease="smooth" interpolation="linear">
                <keyframe time="0" x="0" y="0" alpha="0" />
                <keyframe time="1" alpha="0" />
                <keyframe time="3" alpha="100" />
            </directive>
        </pose>
        <pose id="3-stripB">
            <sprite id="stripped1" src="reskins/spooky_sailor/3-innocent.png" x="0" y="0" alpha="100" />
            <sprite id="stripped2" src="reskins/spooky_sailor/4-innocent.png" x="0" y="0" alpha="0" />
            <directive type="animation" id="stripped1" ease="smooth" interpolation="linear">
                <keyframe time="0" x="0" y="0" alpha="100" />
                <keyframe time="1" alpha="100" />
                <keyframe time="3" alpha="0" />
            </directive>
            <directive type="animation" id="stripped2" ease="smooth" interpolation="linear">
                <keyframe time="0" x="0" y="0" alpha="0" />
                <keyframe time="1" alpha="0" />
                <keyframe time="3" alpha="100" />
            </directive>
        </pose>
    </poses>

</costume>
