"build": {
  "appId": "com.incidiousjacob.spnatiap",
  "productName": "SPNATI Archipelago",
  "files": [
    "index.html",
    "main.js",
    "package.json",
    "js/**/*",
    "css/**/*",
    "style/**/*"
  ],
  "extraResources": [
    {
      "from": "opponents",
      "to": "game_data/opponents"
    },
    {
      "from": "backgrounds",
      "to": "game_data/backgrounds"
    },
    {
      "from": "img",
      "to": "game_data/img"
    },
    {
      "from": "data",
      "to": "game_data/data"
    },
    {
      "from": "sounds",
      "to": "game_data/sounds"
    },
    {
      "from": "cards",
      "to": "game_data/cards"
    },
    {
      "from": "resources",
      "to": "game_data/resources"
    }
  ],
  "win": {
    "target": "portable"
  }
}
